# Preserve document and fixture bytes on Windows (including ASCII-only PDFs).
*.pdf binary
*.xor binary
*.doc binary
*.docx binary
*.ppt binary
*.pptx binary
*.xls binary
*.xlsx binary
*.rtf text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ttf binary
# 多格式安装验收按原字节摘要绑定网页输入，禁止Windows检出改写换行。
/demo/web_docs/*.html -text
/demo/web_docs/*.mhtml -text
